## Cedro Backend - exemplo de .env
# Copie este arquivo para `.env` antes de rodar a aplicação e preencha os valores.

# Porta do servidor (opcional, padrão 8080 caso não setado)
PORT=8080

# Banco de dados - exemplo para SQL Server
# Formato JDBC: jdbc:sqlserver://HOST:PORT;databaseName=DB_NAME
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=CedroDB;encrypt=false;trustServerCertificate=true
DATABASE_USERNAME=your-database-user
DATABASE_PASSWORD=your-database-password

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# RevenueCat webhook
REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-webhook-secret

# Ambiente/profile (opcional, usado apenas para referência)
SPRING_PROFILES_ACTIVE=development

# Observações:
# - `spring.datasource.url` no `application.properties` usa a variável DATABASE_URL.
# - Preencha com credenciais reais antes de rodar; para testes locais você pode usar um
#   servidor SQL Server Docker, ou apontar para um DB de desenvolvimento.
