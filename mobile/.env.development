# Configurações de Ambiente - Cedro Mobile
# Este arquivo contém as variáveis públicas expostas para o App React Native.
# Atenção: O prefixo EXPO_PUBLIC_ é obrigatório para que a variável fique acessível no JS.

# ==============================================================================
# URL BASE DA API SPRING BOOT
# ==============================================================================
# API em produção no Render.com
EXPO_PUBLIC_API_URL=https://cedro-vc32.onrender.com

# Para desenvolvimento local (se necessário):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080  # Emulador Android
# EXPO_PUBLIC_API_URL=http://localhost:8080  # iOS Simulator
# EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:8080  # Dispositivo físico

# ==============================================================================
# CHAVES DO REVENUECAT (Assinatura / Paywall - Opcional para rodar localmente sem testar compras)
# ==============================================================================
EXPO_PUBLIC_RC_APPLE=sua_chave_publica_da_app_store_aqui
EXPO_PUBLIC_RC_GOOGLE=sua_chave_publica_da_play_store_aqui
